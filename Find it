<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="description" content="A clean, simple web search homepage.">
  <title>FindIt — Web Search</title>
  <style>
    :root {
      color-scheme: dark;
      --bg: #0b1020;
      --panel: rgba(20, 29, 52, .82);
      --text: #f4f7ff;
      --muted: #a8b2ca;
      --accent: #7c9cff;
      --accent2: #a78bfa;
      --border: rgba(255,255,255,.12);
    }
    * { box-sizing: border-box; }
    body {
      margin: 0; min-height: 100vh; color: var(--text);
      font-family: Inter, ui-sans-serif, system-ui, -apple-system, Segoe UI, sans-serif;
      background:
        radial-gradient(ellipse at 18% 10%, rgba(83,111,230,.24), transparent 38%),
        radial-gradient(ellipse at 82% 85%, rgba(142,91,214,.18), transparent 35%),
        var(--bg);
      display: grid; place-items: center; padding: 28px;
    }
    main { width: min(760px, 100%); text-align: center; }
    .logo {
      width: 66px; height: 66px; margin: 0 auto 20px; border-radius: 22px;
      display: grid; place-items: center; font-size: 30px; font-weight: 800;
      background: linear-gradient(135deg, var(--accent), var(--accent2));
      box-shadow: 0 14px 40px rgba(100,116,255,.28);
    }
    h1 { margin: 0; font-size: clamp(2.5rem, 8vw, 4.5rem); letter-spacing: -.06em; }
    .subtitle { color: var(--muted); margin: 12px 0 34px; font-size: 1.05rem; }
    .search-card {
      padding: 12px; border: 1px solid var(--border); border-radius: 22px;
      background: var(--panel); box-shadow: 0 24px 80px rgba(0,0,0,.28);
      backdrop-filter: blur(16px);
    }
    .search-row { display: flex; gap: 10px; }
    input {
      flex: 1; min-width: 0; border: 0; outline: 0; color: var(--text);
      background: transparent; padding: 17px 14px; font-size: 1rem;
    }
    input::placeholder { color: #8793af; }
    button {
      border: 0; border-radius: 14px; padding: 0 23px; cursor: pointer;
      color: #081126; font-size: .98rem; font-weight: 750;
      background: linear-gradient(135deg, #9db5ff, #c4a7ff);
      transition: transform .15s ease, filter .15s ease;
    }
    button:hover { transform: translateY(-1px); filter: brightness(1.08); }
    button:focus-visible, input:focus-visible, a:focus-visible {
      outline: 3px solid #c4a7ff; outline-offset: 3px;
    }
    .engines { display: flex; justify-content: center; gap: 9px; flex-wrap: wrap; margin-top: 18px; }
    .engine {
      border: 1px solid var(--border); border-radius: 999px; padding: 9px 15px;
      color: var(--muted); background: rgba(255,255,255,.04); cursor: pointer;
      font-size: .88rem;
    }
    .engine[aria-pressed="true"] {
      color: var(--text); border-color: rgba(157,181,255,.65);
      background: rgba(124,156,255,.16);
    }
    .hint { color: var(--muted); font-size: .86rem; margin-top: 26px; }
    .recent { margin: 26px auto 0; text-align: left; max-width: 600px; }
    .recent-heading { display:flex; align-items:center; justify-content:space-between; color:var(--muted); font-size:.82rem; margin-bottom:10px; }
    .recent-list { display:flex; flex-wrap:wrap; gap:8px; }
    .recent-item { border:1px solid var(--border); background:rgba(255,255,255,.04); color:var(--text); border-radius:999px; padding:8px 12px; font-size:.82rem; cursor:pointer; }
    .recent-item:hover { background:rgba(124,156,255,.16); }
    .clear-recent { background:transparent; color:#b9c8ff; padding:4px 7px; font-size:.8rem; }
    .quick-links { display: flex; justify-content: center; gap: 20px; margin-top: 22px; flex-wrap: wrap; }
    .quick-links a { color: #b9c8ff; text-decoration: none; font-size: .9rem; }
    .quick-links a:hover { text-decoration: underline; }
    footer { color: #73809c; font-size: .78rem; margin-top: 58px; }
    @media (max-width: 520px) {
      body { padding: 20px; }
      .search-row { flex-direction: column; }
      button { min-height: 52px; }
      .search-card { padding: 10px; }
    }
  </style>
</head>
<body>
  <main>
    <div class="logo" aria-hidden="true">F</div>
    <h1>FindIt<span style="color:#9db5ff">.</span></h1>
    <p class="subtitle">A simple place to start your search across the web.</p>

    <section class="search-card" aria-label="Web search">
      <form id="searchForm" class="search-row" action="https://www.google.com/search" method="get" target="_blank">
        <input id="query" type="search" name="q" placeholder="What are you looking for?" aria-label="Search the web" required>
        <button type="submit">Search the web ↗</button>
      </form>
    </section>

    <div class="engines" aria-label="Choose search engine">
      <button class="engine" type="button" data-engine="google" aria-pressed="true">Google</button>
      <button class="engine" type="button" data-engine="bing" aria-pressed="false">Bing</button>
      <button class="engine" type="button" data-engine="duckduckgo" aria-pressed="false">DuckDuckGo</button>
    </div>

    <p class="hint">Choose a search engine, type a question, and press Enter. Tip: press <kbd>/</kbd> to jump to search.</p>
    <section class="recent" aria-label="Recent searches">
      <div class="recent-heading">
        <span>Recent searches</span>
        <button class="clear-recent" id="clearRecent" type="button">Clear history</button>
      </div>
      <div class="recent-list" id="recentList"><span style="color:#8793af;font-size:.85rem">Your searches will appear here.</span></div>
    </section>
    <nav class="quick-links" aria-label="Popular websites">
      <a href="https://www.wikipedia.org/" target="_blank" rel="noopener noreferrer">Wikipedia</a>
      <a href="https://www.youtube.com/" target="_blank" rel="noopener noreferrer">YouTube</a>
      <a href="https://www.reddit.com/" target="_blank" rel="noopener noreferrer">Reddit</a>
      <a href="https://www.github.com/" target="_blank" rel="noopener noreferrer">GitHub</a>
    </nav>
    <footer>FindIt is a search homepage. Searches are handled by the search engine you select.</footer>
  </main>

  <script>
    const engines = {
      google: "https://www.google.com/search",
      bing: "https://www.bing.com/search",
      duckduckgo: "https://duckduckgo.com/"
    };
    const form = document.getElementById("searchForm");
    const engineButtons = document.querySelectorAll("[data-engine]");

    engineButtons.forEach(button => {
      button.addEventListener("click", () => {
        engineButtons.forEach(item => item.setAttribute("aria-pressed", "false"));
        button.setAttribute("aria-pressed", "true");
        form.action = engines[button.dataset.engine];
      });
    });

    // Save recent searches in this browser.
    const input = document.getElementById("query");
    const recentList = document.getElementById("recentList");
    const clearRecent = document.getElementById("clearRecent");
    const STORAGE_KEY = "findit-recent-searches";

    function getRecentSearches() {
      try {
        return JSON.parse(localStorage.getItem(STORAGE_KEY) || "[]");
      } catch {
        return [];
      }
    }

    function renderRecentSearches() {
      const searches = getRecentSearches();
      recentList.replaceChildren();

      if (searches.length === 0) {
        const empty = document.createElement("span");
        empty.textContent = "Your searches will appear here.";
        empty.style.cssText = "color:#8793af;font-size:.85rem";
        recentList.appendChild(empty);
        return;
      }

      searches.forEach(search => {
        const chip = document.createElement("button");
        chip.type = "button";
        chip.className = "recent-item";
        chip.textContent = search;
        chip.addEventListener("click", () => {
          input.value = search;
          form.requestSubmit();
        });
        recentList.appendChild(chip);
      });
    }

    form.addEventListener("submit", () => {
      const search = input.value.trim();
      if (!search) return;

      const searches = getRecentSearches().filter(item => item !== search);
      searches.unshift(search);
      try {
        localStorage.setItem(STORAGE_KEY, JSON.stringify(searches.slice(0, 6)));
      } catch {
        // Search still works if browser storage is unavailable.
      }
      renderRecentSearches();
    });

    clearRecent.addEventListener("click", () => {
      try {
        localStorage.removeItem(STORAGE_KEY);
      } catch {}
      renderRecentSearches();
    });

    // Press "/" to focus the search field, unless typing in another field.
    document.addEventListener("keydown", event => {
      if (event.key === "/" && !["INPUT", "TEXTAREA"].includes(document.activeElement.tagName)) {
        event.preventDefault();
        input.focus();
      }
    });

    renderRecentSearches();
  </script>
</body>
</html>
